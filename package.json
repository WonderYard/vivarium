    "typecheck": "tsc --noEmit",
    "test": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.15",
    "@types/node": "^25.2.3",
    "@vitejs/plugin-basic-ssl": "^2.1.4",
    "@vitest/browser-playwright": "^4.0.18",
    "@webgpu/types": "^0.1.69",
    "glob": "^13.0.3",
    "globals": "^17.3.0",
    "jiti": "^2.6.1",
    "playwright": "^1.58.2",
    "typescript": "~5.9.3",
    "unplugin-typegpu": "^0.9.0",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@typegpu/noise": "^0.9.0",
    "nanoid": "^5.1.6",
    "typegpu": "^0.9.0"
