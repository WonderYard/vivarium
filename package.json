{
  "name": "@wonderyard/vivarium",
  "description": "Modern, intuitive, WebGPU-powered toolkit for creating your own cellular automata.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "module": "./dist/main.js",
  "scripts": {
    "dev": "vite",
    "dev:https": "ENABLE_BASIC_SSL=true vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "biome check --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.2",
    "@types/node": "^24.3.0",
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "@webgpu/types": "^0.1.64",
    "glob": "^11.0.3",
    "globals": "^16.3.0",
    "jiti": "^2.5.1",
    "typescript": "~5.8.3",
    "unplugin-typegpu": "^0.2.2",
    "vite": "^7.1.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@typegpu/noise": "^0.7.0",
    "nanoid": "^5.1.5",
    "typegpu": "^0.7.1"
  }
}
