  "license": "MIT",
  "author": "OrangeNote",
  "keywords": [
    "cellular-automata",
    "compute",
    "creative-coding",
    "game-of-life",
    "simulation",
    "webgpu"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "module": "./dist/main.js",
  "scripts": {
    "dev": "vite",
    "dev:https": "ENABLE_BASIC_SSL=true vite --host",
